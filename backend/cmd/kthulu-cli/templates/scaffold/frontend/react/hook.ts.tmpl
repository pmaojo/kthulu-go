// @kthulu:frontend:hook
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { {{.Title}} } from '../domain/{{.Title}}';
import { {{.Title}}Service } from '../infrastructure/{{.Title}}Service';

export const use{{.Title}}s = () => {
  const queryClient = useQueryClient();

  // Retrieve Layer (Read)
  const { data, isLoading, error } = useQuery({
    queryKey: ['{{.PluralName | lower}}'],
    queryFn: {{.Title}}Service.list,
  });

  // Mutations (Write)
  const createMutation = useMutation({
    mutationFn: ({{.Name}}: Omit<{{.Title}}, 'id'>) => {{.Title}}Service.create({{.Name}}),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['{{.PluralName | lower}}'] });
    },
  });

  const updateMutation = useMutation({
    mutationFn: ({ id, data }: { id: number; data: Partial<{{.Title}}> }) => 
      {{.Title}}Service.update(id, data),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['{{.PluralName | lower}}'] });
    },
  });

  const deleteMutation = useMutation({
    mutationFn: (id: number) => {{.Title}}Service.delete(id),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['{{.PluralName | lower}}'] });
    },
  });

  return {
    data: data || [],
    loading: isLoading,
    error,
    create: createMutation.mutateAsync,
    update: (id: number, data: Partial<{{.Title}}>) => updateMutation.mutateAsync({ id, data }),
    remove: deleteMutation.mutateAsync,
  };
};
