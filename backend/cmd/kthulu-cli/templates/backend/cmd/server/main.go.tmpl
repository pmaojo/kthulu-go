func NewRouter(logger *slog.Logger) *mux.Router {
	r := mux.NewRouter()
	r.Use(middleware.ObservabilityMiddleware(logger))
	r.Use(middleware.RecoveryMiddleware(logger))
	r.Handle("/metrics", promhttp.Handler())

	// Serve embedded static assets with compression support
	// We use StripPrefix so the file server sees relative paths (e.g. /assets/js/main.js -> js/main.js)
	r.PathPrefix("/assets/").Handler(http.StripPrefix("/assets/", static.ServeMiddleware(http.NotFoundHandler())))

	r.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusOK)
		w.Write([]byte("OK"))
	})
	return r
}

func NewDB(cfg *config.Config) (*gorm.DB, error) {
	// Standard SQLite connection.
	return gorm.Open(sqlite.Open("app.db"), &gorm.Config{})
}

