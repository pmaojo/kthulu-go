func InitializeScenario(ctx *godog.ScenarioContext) {
	c := &BDDContext{}

	ctx.Before(func(ctx context.Context, sc *godog.Scenario) (context.Context, error) {
		return ctx, nil
	})

	ctx.After(func(ctx context.Context, sc *godog.Scenario, err error) (context.Context, error) {
		if c.server != nil {
			c.server.Close()
		}
		return ctx, nil
	})

	ctx.Step(`^the service is running$`, c.theServiceIsRunning)
	ctx.Step(`^I send a GET request to "([^"]*)"$`, c.iSendAGETRequestTo)
	ctx.Step(`^the response code should be (\d+)$`, c.theResponseCodeShouldBe)
	ctx.Step(`^the response body should contain "([^"]*)"$`, c.theResponseBodyShouldContain)
}

func TestMain(m *testing.M) {
	opts := godog.Options{
		Format:    "pretty",
		Paths:     []string{"../../features"},
		Randomize: time.Now().UTC().UnixNano(),
	}

	status := godog.TestSuite{
		Name:                "bdd-tests",
		ScenarioInitializer: InitializeScenario,
		Options:             &opts,
	}.Run()

	if st := m.Run(); st > status {
		status = st
	}
}
