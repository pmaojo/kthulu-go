// BDDContext holds state for steps
type BDDContext struct {
	server   *httptest.Server
	resp     *http.Response
	lastBody string
}

func (c *BDDContext) theServiceIsRunning() error {
	// In a real scenario, we would start the actual service or a mock.
	// For this template, we spin up a simple test server.
	handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path == "/health" {
			w.WriteHeader(http.StatusOK)
			w.Write([]byte(`{"status":"ok"}`))
			return
		}
		w.WriteHeader(http.StatusNotFound)
	})

	c.server = httptest.NewServer(handler)
	return nil
}

func (c *BDDContext) iSendAGETRequestTo(endpoint string) error {
	if c.server == nil {
		return fmt.Errorf("server not started")
	}

	resp, err := http.Get(c.server.URL + endpoint)
	if err != nil {
		return err
	}
	c.resp = resp
	return nil
}

func (c *BDDContext) theResponseCodeShouldBe(code int) error {
	if c.resp == nil {
		return fmt.Errorf("no response received")
	}
	if c.resp.StatusCode != code {
		return fmt.Errorf("expected status %d, got %d", code, c.resp.StatusCode)
	}
	return nil
}

