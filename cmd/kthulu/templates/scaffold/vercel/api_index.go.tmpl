// @kthulu:vercel:entrypoint
package handler

import (
	"context"
	"net/http"
	"sync"
	"time"


	"github.com/gorilla/mux"
	"go.uber.org/fx"
	
	"{{.ProjectModule}}/pkg/bootstrap"
)

var (
	appHandler http.Handler
	once       sync.Once
)

func init() {
	once.Do(func() {
		// Auto-migrate if enabled
		bootstrap.RunMigrations()
		
		// Initialize the application via Fx
		var router *mux.Router
		
		opts := bootstrap.AppOptions()
		// Populate the router so we can assign it to appHandler
		opts = append(opts, fx.Populate(&router))
		
		app := fx.New(opts...)
		
		// Start the app to run any lifecycle hooks (e.g. DB connection),
        // but explicit server starting is avoided as it's not in AppOptions.
		startCtx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		
		if err := app.Start(startCtx); err != nil {
			// In Vercel logs this will show up if initialization fails
			panic(err)
		}
		
		appHandler = router
	})
}

// Handler is the Vercel serverless function entrypoint
func Handler(w http.ResponseWriter, r *http.Request) {
	if appHandler != nil {
		appHandler.ServeHTTP(w, r)
	} else {
		http.Error(w, "Application initialization failed", http.StatusInternalServerError)
	}
}
