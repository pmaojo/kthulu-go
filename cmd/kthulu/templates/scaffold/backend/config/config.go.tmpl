package config

import (
    "os"
{{- if ne .Database "sqlite"}}
    "fmt"
{{- end}}
)

type DatabaseConfig struct {
    URL    string
    Driver string
}

type Config struct {
    Database DatabaseConfig
    Env      string
}

func NewConfig() (*Config, error) {
    dbDriver := getEnv("DB_DRIVER", "{{.Database}}")
    dbURL := os.Getenv("DATABASE_URL")

    // Default DSN construction if not provided (Development Defaults)
    if dbURL == "" {
        {{if eq .Database "sqlite"}}
        dbURL = getEnv("SQLITE_PATH", "data/{{.ProjectName}}.db")
        {{else if eq .Database "postgres"}}
        // WARN: These are development defaults. Use env vars for production.
        dbURL = fmt.Sprintf("postgres://%s:%s@%s:%s/%s?sslmode=disable",
            getEnv("DB_USER", "postgres"),
            getEnv("DB_PASSWORD", "postgres"),
            getEnv("DB_HOST", "localhost"),
            getEnv("DB_PORT", "5432"),
            getEnv("DB_NAME", "{{.ProjectName}}"),
        )
        {{else if eq .Database "mysql"}}
        // WARN: These are development defaults. Use env vars for production.
        dbURL = fmt.Sprintf("%s:%s@tcp(%s:%s)/%s?parseTime=true",
            getEnv("DB_USER", "root"),
            getEnv("DB_PASSWORD", "password"),
            getEnv("DB_HOST", "localhost"),
            getEnv("DB_PORT", "3306"),
            getEnv("DB_NAME", "{{.ProjectName}}"),
        )
        {{end}}
    }

    return &Config{
        Database: DatabaseConfig{
            URL:    dbURL,
            Driver: dbDriver,
        },
        Env: getEnv("ENV", "development"),
    }, nil
}

func getEnv(key, fallback string) string {
    if value := os.Getenv(key); value != "" {
        return value
    }
    return fallback
}
