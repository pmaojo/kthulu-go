// decode{{.Title}} decodes a JSON request body into the entity. Numeric and
// boolean values submitted as strings (e.g. HTML forms via htmx json-enc)
// are coerced to their typed equivalents before unmarshalling.
func decode{{.Title}}(r *http.Request) (core.{{.Title}}, error) {
	var entity core.{{.Title}}
	var raw map[string]interface{}
	if err := json.NewDecoder(r.Body).Decode(&raw); err != nil {
		return entity, err
	}
	for key := range raw {
		switch key {
{{- range .Fields}}
{{- if or (eq .Type "int") (eq .Type "uint") (eq .Type "float64")}}
		case "{{.JSONTag}}":
			raw[key] = coerceNumber(raw[key])
{{- else if eq .Type "bool"}}
		case "{{.JSONTag}}":
			raw[key] = coerceBool(raw[key])
{{- else if eq .Type "time.Time"}}
		case "{{.JSONTag}}":
			raw[key] = coerceTime(raw[key])
{{- end}}
{{- end}}
		}
	}
	data, err := json.Marshal(raw)
	if err != nil {
		return entity, err
	}
	if err := json.Unmarshal(data, &entity); err != nil {
		return entity, err
	}
	return entity, nil
}

// writeServiceError maps service errors to HTTP responses. Validation
// failures become a 422 with a field->message map; everything else is a 500.
func writeServiceError(w http.ResponseWriter, err error) {
	var verrs core.ValidationErrors
	if errors.As(err, &verrs) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusUnprocessableEntity)
		json.NewEncoder(w).Encode(map[string]interface{}{"errors": verrs})
		return
	}
	http.Error(w, err.Error(), http.StatusInternalServerError)
}

func coerceNumber(v interface{}) interface{} {
	if s, ok := v.(string); ok {
		if n, err := strconv.ParseFloat(s, 64); err == nil {
			return n
		}
	}
	return v
}

func coerceBool(v interface{}) interface{} {
	if s, ok := v.(string); ok {
		if b, err := strconv.ParseBool(s); err == nil {
			return b
		}
	}
	return v
}

func coerceTime(v interface{}) interface{} {
	s, ok := v.(string)
	if !ok {
		return v
	}
	for _, layout := range []string{time.RFC3339, "2006-01-02T15:04", "2006-01-02"} {
		if t, err := time.Parse(layout, s); err == nil {
			return t.Format(time.RFC3339)
		}
	}
	return v
}

