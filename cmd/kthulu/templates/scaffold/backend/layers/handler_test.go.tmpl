// @kthulu:test:handlers:{{.Name}}
package handlers

import (
	"encoding/json"
	"fmt"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/gorilla/mux"
	"{{.DomainImport}}"
)

type fake{{.Title}}Service struct {
	store  map[uint]*domain.{{.Title}}
	nextID uint
}

func newFake{{.Title}}Service() *fake{{.Title}}Service {
	return &fake{{.Title}}Service{store: make(map[uint]*domain.{{.Title}}), nextID: 1}
}

func (s *fake{{.Title}}Service) Create{{.Title}}(entity *domain.{{.Title}}) error {
	if entity.ID == 0 {
		entity.ID = s.nextID
		s.nextID++
	}
	s.store[entity.ID] = entity
	return nil
}

func (s *fake{{.Title}}Service) Get{{.Title}}ByID(id uint) (*domain.{{.Title}}, error) {
	if entity, ok := s.store[id]; ok {
		return entity, nil
	}
	return nil, fmt.Errorf("not found")
}

func (s *fake{{.Title}}Service) Update{{.Title}}(entity *domain.{{.Title}}) error {
	s.store[entity.ID] = entity
	return nil
}

func (s *fake{{.Title}}Service) Delete{{.Title}}(id uint) error {
	delete(s.store, id)
	return nil
}

func (s *fake{{.Title}}Service) List{{.PluralTitle}}(filter domain.SearchFilter) ([]*domain.{{.Title}}, error) {
	items := make([]*domain.{{.Title}}, 0, len(s.store))
	for _, entity := range s.store {
		items = append(items, entity)
	}
	return items, nil
}

func Test{{.Title}}HandlerCRUD(t *testing.T) {
	service := newFake{{.Title}}Service()
	handler := New{{.Title}}Handler(service)
	router := mux.NewRouter()
	handler.RegisterRoutes(router)

	createReq := httptest.NewRequest(http.MethodPost, "/{{.Name}}", strings.NewReader(`{}`))
	createRec := httptest.NewRecorder()
	router.ServeHTTP(createRec, createReq)
	if createRec.Code != http.StatusOK {
		t.Fatalf("expected 200 got %d", createRec.Code)
	}
	var created domain.{{.Title}}
	if err := json.NewDecoder(createRec.Body).Decode(&created); err != nil {
		t.Fatalf("decode failed: %v", err)
	}

	listReq := httptest.NewRequest(http.MethodGet, "/{{.Name}}", nil)
	listRec := httptest.NewRecorder()
	router.ServeHTTP(listRec, listReq)
	if listRec.Code != http.StatusOK {
		t.Fatalf("expected 200 got %d", listRec.Code)
	}

	getReq := httptest.NewRequest(http.MethodGet, fmt.Sprintf("/{{.Name}}/%d", created.ID), nil)
	getRec := httptest.NewRecorder()
	router.ServeHTTP(getRec, getReq)
	if getRec.Code != http.StatusOK {
		t.Fatalf("expected 200 got %d", getRec.Code)
	}

	updateReq := httptest.NewRequest(http.MethodPut, fmt.Sprintf("/{{.Name}}/%d", created.ID), strings.NewReader(`{}`))
	updateRec := httptest.NewRecorder()
	router.ServeHTTP(updateRec, updateReq)
	if updateRec.Code != http.StatusOK {
		t.Fatalf("expected 200 got %d", updateRec.Code)
	}

	deleteReq := httptest.NewRequest(http.MethodDelete, fmt.Sprintf("/{{.Name}}/%d", created.ID), nil)
	deleteRec := httptest.NewRecorder()
	router.ServeHTTP(deleteRec, deleteReq)
	if deleteRec.Code != http.StatusNoContent {
		t.Fatalf("expected 204 got %d", deleteRec.Code)
	}
}
