package storage

import (
	"context"
	"fmt"
	"io"
	"net/url"
	"os"
	"path/filepath"
	"strings"
	"time"
)

// Storage defines the interface for file storage operations
type Storage interface {
	// Basic operations
	Put(ctx context.Context, path string, content io.Reader) error
	PutBytes(ctx context.Context, path string, data []byte) error
	Get(ctx context.Context, path string) (io.ReadCloser, error)
	GetBytes(ctx context.Context, path string) ([]byte, error)
	Delete(ctx context.Context, path string) error
	Exists(ctx context.Context, path string) (bool, error)
	
	// Directory operations
	List(ctx context.Context, prefix string) ([]FileInfo, error)
	DeleteDirectory(ctx context.Context, path string) error
	
	// URL generation
	URL(path string) string
	TemporaryURL(ctx context.Context, path string, expiry time.Duration) (string, error)
	
	// Metadata
	Size(ctx context.Context, path string) (int64, error)
	LastModified(ctx context.Context, path string) (time.Time, error)
	
	// Copy/Move
	Copy(ctx context.Context, from, to string) error
	Move(ctx context.Context, from, to string) error
}

// FileInfo represents file metadata
type FileInfo struct {
	Path         string
	Size         int64
	LastModified time.Time
	IsDirectory  bool
}

// Config holds storage configuration
type Config struct {
	Driver    string // local, s3, gcs, azure
	Root      string // Base path for local storage
	URL       string // Base URL for public files
	
	// S3/MinIO config
	S3Endpoint  string
	S3Region    string
	S3Bucket    string
	S3Key       string
	S3Secret    string
	S3UseSSL    bool
	
	// GCS config
	GCSBucket     string
	GCSProjectID  string
	GCSCredFile   string
	
	// Azure config
	AzureAccount   string
	AzureKey       string
	AzureContainer string
}

// NewStorage creates a new storage instance based on configuration
func NewStorage() Storage {
	config := loadConfig()
	
	switch strings.ToLower(config.Driver) {
	case "s3":
		return NewS3Storage(config)
	case "gcs":
		return NewGCSStorage(config)
	case "azure":
		return NewAzureStorage(config)
	default:
		return NewLocalStorage(config)
	}
}

func loadConfig() *Config {
	return &Config{
		Driver:         getEnv("STORAGE_DRIVER", "local"),
		Root:           getEnv("STORAGE_ROOT", "./storage"),
		URL:            getEnv("STORAGE_URL", "/storage"),
		S3Endpoint:     getEnv("S3_ENDPOINT", ""),
		S3Region:       getEnv("AWS_REGION", "us-east-1"),
		S3Bucket:       getEnv("S3_BUCKET", ""),
		S3Key:          getEnv("AWS_ACCESS_KEY_ID", ""),
		S3Secret:       getEnv("AWS_SECRET_ACCESS_KEY", ""),
		S3UseSSL:       getEnv("S3_USE_SSL", "true") == "true",
		GCSBucket:      getEnv("GCS_BUCKET", ""),
		GCSProjectID:   getEnv("GCS_PROJECT_ID", ""),
		GCSCredFile:    getEnv("GOOGLE_APPLICATION_CREDENTIALS", ""),
		AzureAccount:   getEnv("AZURE_STORAGE_ACCOUNT", ""),
		AzureKey:       getEnv("AZURE_STORAGE_KEY", ""),
		AzureContainer: getEnv("AZURE_STORAGE_CONTAINER", ""),
	}
}

func getEnv(key, fallback string) string {
	if value := os.Getenv(key); value != "" {
		return value
	}
	return fallback
}

// ===============================
// Local Storage Implementation
// ===============================

type LocalStorage struct {
	config *Config
}

func NewLocalStorage(config *Config) *LocalStorage {
	// Ensure root directory exists
	os.MkdirAll(config.Root, 0755)
	return &LocalStorage{config: config}
}

func (s *LocalStorage) fullPath(path string) string {
	return filepath.Join(s.config.Root, path)
}

func (s *LocalStorage) Put(ctx context.Context, path string, content io.Reader) error {
	fullPath := s.fullPath(path)
	
	// Ensure directory exists
	if err := os.MkdirAll(filepath.Dir(fullPath), 0755); err != nil {
		return fmt.Errorf("failed to create directory: %w", err)
	}
	
	file, err := os.Create(fullPath)
	if err != nil {
		return fmt.Errorf("failed to create file: %w", err)
	}
	defer file.Close()
	
	if _, err := io.Copy(file, content); err != nil {
		return fmt.Errorf("failed to write file: %w", err)
	}
	
	return nil
}

func (s *LocalStorage) PutBytes(ctx context.Context, path string, data []byte) error {
	fullPath := s.fullPath(path)
	
	if err := os.MkdirAll(filepath.Dir(fullPath), 0755); err != nil {
		return fmt.Errorf("failed to create directory: %w", err)
	}
	
	return os.WriteFile(fullPath, data, 0644)
}

func (s *LocalStorage) Get(ctx context.Context, path string) (io.ReadCloser, error) {
	return os.Open(s.fullPath(path))
}

func (s *LocalStorage) GetBytes(ctx context.Context, path string) ([]byte, error) {
	return os.ReadFile(s.fullPath(path))
}

func (s *LocalStorage) Delete(ctx context.Context, path string) error {
	return os.Remove(s.fullPath(path))
}

func (s *LocalStorage) Exists(ctx context.Context, path string) (bool, error) {
	_, err := os.Stat(s.fullPath(path))
	if os.IsNotExist(err) {
		return false, nil
	}
	return err == nil, err
}

func (s *LocalStorage) List(ctx context.Context, prefix string) ([]FileInfo, error) {
	var files []FileInfo
	root := s.fullPath(prefix)
	
	err := filepath.Walk(root, func(path string, info os.FileInfo, err error) error {
		if err != nil {
			return err
		}
		// Skip the prefix directory itself; callers expect its contents.
		if path == root {
			return nil
		}

		relPath, _ := filepath.Rel(s.config.Root, path)
		files = append(files, FileInfo{
			Path:         relPath,
			Size:         info.Size(),
			LastModified: info.ModTime(),
			IsDirectory:  info.IsDir(),
		})
		return nil
	})
	
	return files, err
}

func (s *LocalStorage) DeleteDirectory(ctx context.Context, path string) error {
	return os.RemoveAll(s.fullPath(path))
}

func (s *LocalStorage) URL(path string) string {
	return s.config.URL + "/" + path
}

func (s *LocalStorage) TemporaryURL(ctx context.Context, path string, expiry time.Duration) (string, error) {
	// Local storage doesn't support signed URLs, return regular URL
	return s.URL(path), nil
}

func (s *LocalStorage) Size(ctx context.Context, path string) (int64, error) {
	info, err := os.Stat(s.fullPath(path))
	if err != nil {
		return 0, err
	}
	return info.Size(), nil
}

func (s *LocalStorage) LastModified(ctx context.Context, path string) (time.Time, error) {
	info, err := os.Stat(s.fullPath(path))
	if err != nil {
		return time.Time{}, err
	}
	return info.ModTime(), nil
}

func (s *LocalStorage) Copy(ctx context.Context, from, to string) error {
	src, err := s.Get(ctx, from)
	if err != nil {
		return err
	}
	defer src.Close()
	
	return s.Put(ctx, to, src)
}

func (s *LocalStorage) Move(ctx context.Context, from, to string) error {
	if err := s.Copy(ctx, from, to); err != nil {
		return err
	}
	return s.Delete(ctx, from)
}

