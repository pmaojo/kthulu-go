// @kthulu:infrastructure:seeder
package seeder

import (
	"context"
	"fmt"
	"log"
	"math/rand"
	"time"

	"gorm.io/gorm"
)

// Seeder manages database seeding
type Seeder struct {
	db      *gorm.DB
	seeders map[string]SeederFunc
	order   []string
}

// SeederFunc is a function that seeds data
type SeederFunc func(ctx context.Context, db *gorm.DB) error

// NewSeeder creates a new seeder
func NewSeeder(db *gorm.DB) *Seeder {
	return &Seeder{
		db:      db,
		seeders: make(map[string]SeederFunc),
		order:   make([]string, 0),
	}
}

// Register adds a new seeder
func (s *Seeder) Register(name string, fn SeederFunc) *Seeder {
	s.seeders[name] = fn
	s.order = append(s.order, name)
	return s
}

// Run executes all seeders in order
func (s *Seeder) Run(ctx context.Context) error {
	log.Println("🌱 Running database seeders...")
	
	for _, name := range s.order {
		fn := s.seeders[name]
		log.Printf("   ▶ Seeding: %s", name)
		
		if err := fn(ctx, s.db); err != nil {
			return fmt.Errorf("seeder '%s' failed: %w", name, err)
		}
		
		log.Printf("   ✅ %s seeded", name)
	}
	
	log.Println("🌱 Seeding complete!")
	return nil
}

// RunOnly runs specific seeders by name
func (s *Seeder) RunOnly(ctx context.Context, names ...string) error {
	for _, name := range names {
		fn, exists := s.seeders[name]
		if !exists {
			return fmt.Errorf("seeder '%s' not found", name)
		}
		
		log.Printf("🌱 Running seeder: %s", name)
		if err := fn(ctx, s.db); err != nil {
			return fmt.Errorf("seeder '%s' failed: %w", name, err)
		}
	}
	return nil
}

// Fresh truncates all tables and re-seeds
func (s *Seeder) Fresh(ctx context.Context) error {
	log.Println("🔄 Fresh seeding - truncating tables...")
	
	// Get all tables
	var tables []string
	if err := s.db.Raw("SELECT tablename FROM pg_tables WHERE schemaname = 'public'").Scan(&tables).Error; err != nil {
		// Fallback for SQLite
		s.db.Raw("SELECT name FROM sqlite_master WHERE type='table'").Scan(&tables)
	}
	
	// Truncate each table
	for _, table := range tables {
		if table == "schema_migrations" || table == "goose_db_version" {
			continue // Skip migration tables
		}
		s.db.Exec(fmt.Sprintf("TRUNCATE TABLE %s CASCADE", table))
	}
	
	return s.Run(ctx)
}

// List returns all registered seeder names
func (s *Seeder) List() []string {
	return s.order
}

