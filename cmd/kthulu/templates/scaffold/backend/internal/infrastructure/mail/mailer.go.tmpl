// TemplateMailer wraps a Mailer with template support
type TemplateMailer struct {
	mailer    Mailer
	templates *template.Template
}

func NewTemplateMailer(mailer Mailer, templatesDir string) (*TemplateMailer, error) {
	tmpl, err := template.ParseGlob(templatesDir + "/*.html")
	if err != nil {
		return nil, fmt.Errorf("failed to parse mail templates: %w", err)
	}
	return &TemplateMailer{mailer: mailer, templates: tmpl}, nil
}

func (m *TemplateMailer) SendTemplate(ctx context.Context, to []string, subject, templateName string, data interface{}) error {
	var buf bytes.Buffer
	if err := m.templates.ExecuteTemplate(&buf, templateName, data); err != nil {
		return fmt.Errorf("failed to execute template: %w", err)
	}
	
	return m.mailer.Send(ctx, &Message{
		To:      to,
		Subject: subject,
		HTML:    buf.String(),
	})
}
