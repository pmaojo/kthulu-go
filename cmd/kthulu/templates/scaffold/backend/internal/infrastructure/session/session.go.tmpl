// ===============================
// HTTP Middleware
// ===============================

type contextKey string

const sessionKey contextKey = "session"

// Middleware adds session to request context
func Middleware(manager *Manager) func(next http.Handler) http.Handler {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			session, err := manager.Start(r.Context(), r)
			if err != nil {
				http.Error(w, "Session error", http.StatusInternalServerError)
				return
			}
			
			// Add session to context
			ctx := context.WithValue(r.Context(), sessionKey, session)
			
			// Wrap response writer to save session after handler
			rw := &responseWriter{ResponseWriter: w, session: session, manager: manager, ctx: ctx}
			
			next.ServeHTTP(rw, r.WithContext(ctx))
			
			// Save session after request
			if !rw.saved {
				manager.Save(ctx, w, session)
			}
		})
	}
}

// FromContext gets session from context
func FromContext(ctx context.Context) *Session {
	if session, ok := ctx.Value(sessionKey).(*Session); ok {
		return session
	}
	return nil
}

type responseWriter struct {
	http.ResponseWriter
	session *Session
	manager *Manager
	ctx     context.Context
	saved   bool
}

func (rw *responseWriter) WriteHeader(code int) {
	if !rw.saved {
		rw.manager.Save(rw.ctx, rw.ResponseWriter, rw.session)
		rw.saved = true
	}
	rw.ResponseWriter.WriteHeader(code)
}
