// AppOptions returns the common Fx options for the application
func AppOptions() []fx.Option {
	return []fx.Option{
		// Core providers
		core.CoreRepositoryProviders(),
		fx.Provide(NewRouter),

		// Module providers
{{.ModuleProviders}}
{{if .QueueEnabled}}
		// Background job queue + scheduler
		fx.Provide(newQueue),
		fx.Invoke(startQueue),
{{end}}
{{if .MailEnabled}}
		// Mail driver (MAIL_DRIVER env: smtp, log, ...)
		fx.Provide(mail.NewMailer),
{{end}}
{{if .StorageEnabled}}
		// File storage driver (STORAGE_DRIVER env: local, ...)
		fx.Provide(storage.NewStorage),
{{end}}
		// Route Registration
		fx.Invoke(RegisterRoutes),
	}
}

{{if .QueueEnabled}}
func newQueue(db *gorm.DB) (*queue.Queue, error) {
	return queue.New(db)
}

// startQueue registers application jobs and ties the worker pool to the
// application lifecycle.
func startQueue(lc fx.Lifecycle, q *queue.Queue) error {
	if err := jobs.Register(q); err != nil {
		return err
	}
	lc.Append(fx.Hook{
		OnStart: func(context.Context) error {
			q.Start()
			return nil
		},
		OnStop: func(ctx context.Context) error {
			return q.Stop(ctx)
		},
	})
	return nil
}
{{end}}

// RunMigrations runs database migrations if enabled via env var
func RunMigrations() {
	if os.Getenv("RUN_MIGRATIONS") == "true" {
		db, err := database.NewDB()
		if err == nil {
			database.AutoMigrate(db)
		}
	}
}

// RegisterRoutes registers all application routes
func RegisterRoutes(router *mux.Router, {{.InvokeParams}}) {
{{if .GTHEnabled}}
	// Register GTH (HTML) web routes
	gth.RegisterRoutes(router, {{range .FeatureList}}{{if ne . "auth"}}{{.}}Service, {{end}}{{end}})
{{end}}
	// Register API routes
	apiRouter := router.PathPrefix("/api/v1").Subrouter()

{{.ModuleRoutes}}
}

// NewRouter creates a new mux router with health check
func NewRouter() *mux.Router {
	router := mux.NewRouter()

	router.HandleFunc("/health", func(w http.ResponseWriter, r *http.Request) {
		w.WriteHeader(http.StatusOK)
		_, _ = w.Write([]byte("OK"))
	})

	return router
}
