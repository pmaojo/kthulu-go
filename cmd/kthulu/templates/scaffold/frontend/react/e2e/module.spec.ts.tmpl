import { test, expect } from '@playwright/test';

test.describe('{{ .Title }} Module', () => {
  test.beforeEach(async ({ page }) => {
    // Navigate to the module page
    await page.goto('/{{ .Name }}');
  });

  test('should display empty state or list', async ({ page }) => {
    await expect(page.getByRole('heading', { level: 2 })).toHaveText('{{ .Title }}s');
  });

  test('should open create dialog', async ({ page }) => {
    await page.getByRole('button', { name: 'Add {{ .Title }}' }).click();
    await expect(page.getByRole('dialog')).toBeVisible();
    await expect(page.getByRole('heading', { level: 3, name: 'Create {{ .Title }}' })).toBeVisible();
  });

  test('should create a new {{ .Name }}', async ({ page }) => {
    await page.getByRole('button', { name: 'Add {{ .Title }}' }).click();
    
    // Fill form fields
    {{ range .Fields }}
    await page.getByLabel('{{ .Name | capitalize }}').fill('Test {{ .Name }}');
    {{ end }}

    await page.getByRole('button', { name: 'Save' }).click();

    // Verify it appears in the list
    await expect(page.getByText('Test {{ (index .Fields 0).Name }}')).toBeVisible();
  });
});
