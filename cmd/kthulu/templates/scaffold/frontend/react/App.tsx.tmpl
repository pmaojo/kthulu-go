// @kthulu:frontend:app
import { BrowserRouter as Router, Routes, Route, Link } from 'react-router-dom';
import { Home, LayoutDashboard, Settings } from 'lucide-react';

// Module Imports
{{ range .Features }}
import {{ . | capitalize }}Page from './modules/{{ . }}/presentation/{{ . | capitalize }}Page';
{{ end }}

function App() {
  return (
    <Router>
      <div className="min-h-screen flex">
        {/* Sidebar */}
        <aside className="w-64 bg-slate-900 text-white p-6">
          <div className="text-2xl font-bold mb-8">Kthulu App</div>
          <nav className="space-y-4">
            <Link to="/" className="flex items-center gap-3 p-2 hover:bg-slate-800 rounded">
              <Home size={20} /> Dashboard
            </Link>
            {{ range .Features }}
            <Link to="/{{ . }}" className="flex items-center gap-3 p-2 hover:bg-slate-800 rounded">
              <LayoutDashboard size={20} /> {{ . | capitalize }}
            </Link>
            {{ end }}
          </nav>
        </aside>

        {/* Main Content */}
        <main className="flex-1 bg-gray-50">
          <Routes>
            <Route path="/" element={<div className="p-8"><h1 className="text-3xl font-bold">Welcome Dashboard</h1></div>} />
            {{ range .Features }}
            <Route path="/{{ . }}" element={<{{ . | capitalize }}Page />} />
            {{ end }}
          </Routes>
        </main>
      </div>
    </Router>
  );
}

export default App;
