import { lazy } from 'react';
import { registerModule, type Module } from '../registry';

// Lazy load the main page component
const {{.Title}}Page = lazy(() => import('./presentation/{{.Title}}Page'));

const module: Module = {
  routes: [
    {
      path: '/{{.PluralName}}',
      Component: {{.Title}}Page,
    },
  ],
  components: {},
};

registerModule(module);
