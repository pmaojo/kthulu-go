{{- /* @kthulu:component:form:{{.Name}} */ -}}
{{- /* Form Component */ -}}
package components

import (
	"strconv"
	"{{.CoreImport}}"
)

templ {{.Title}}Form(item *core.{{.Title}}, isEdit bool) {
	<form 
		if isEdit {
			hx-put={ "/api/v1/{{.RoutePrefix}}/" + strconv.FormatUint(uint64(item.ID), 10) }
		} else {
			hx-post="/api/v1/{{.RoutePrefix}}/"
		}
		hx-target="#modal-container"
		hx-swap="none"
		hx-ext="json-enc"
		hx-on::after-request="if(event.detail.successful) { htmx.trigger('#table-body', 'refresh'); document.getElementById('modal-container').innerHTML = ''; }"
	>
		<div class="modal-header">
			if isEdit {
				Edit {{.Title}}
			} else {
				Create {{.Title}}
			}
		</div>
		
		<div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
			{{range .Fields}}
			{{if not .Relation}}
			<div>
				<label class="label" for="{{.JSONTag}}">{{.Name}}</label>
				{{if eq .Type "text"}}
				<textarea
					id="{{.JSONTag}}"
					name="{{.JSONTag}}"
					class="input"
					rows="3"
				>{ item.{{.Name}} }</textarea>
				{{else if eq .Type "bool"}}
				<input
					type="checkbox"
					id="{{.JSONTag}}"
					name="{{.JSONTag}}"
					if item.{{.Name}} {
						checked
					}
				/>
				{{else if eq .Type "int"}}
				<input
					type="number"
					id="{{.JSONTag}}"
					name="{{.JSONTag}}"
					class="input"
					value={ strconv.Itoa(item.{{.Name}}) }
				/>
				{{else if eq .Type "uint"}}
				<input
					type="number"
					id="{{.JSONTag}}"
					name="{{.JSONTag}}"
					class="input"
					value={ strconv.FormatUint(uint64(item.{{.Name}}), 10) }
				/>
				{{else if eq .Type "float64"}}
				<input
					type="number"
					step="any"
					id="{{.JSONTag}}"
					name="{{.JSONTag}}"
					class="input"
					value={ strconv.FormatFloat(item.{{.Name}}, 'f', -1, 64) }
				/>
				{{else if eq .Type "time.Time"}}
				<input
					type="datetime-local"
					id="{{.JSONTag}}"
					name="{{.JSONTag}}"
					class="input"
					value={ item.{{.Name}}.Format("2006-01-02T15:04") }
				/>
				{{else}}
				<input
					type="text"
					id="{{.JSONTag}}"
					name="{{.JSONTag}}"
					class="input"
					value={ item.{{.Name}} }
				/>
				{{end}}
			</div>
			{{end}}
			{{end}}
		</div>
		
		<div class="modal-footer">
			<button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-container').innerHTML = ''">
				Cancel
			</button>
			<button type="submit" class="btn btn-primary">
				if isEdit {
					Update
				} else {
					Create
				}
			</button>
		</div>
	</form>
}

templ {{.Title}}FormModal(item *core.{{.Title}}, isEdit bool) {
	<div class="modal-backdrop" onclick="if(event.target === this) this.remove()">
		<div class="modal">
			@{{.Title}}Form(item, isEdit)
		</div>
	</div>
}
