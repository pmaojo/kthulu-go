// RegisterRoutes registers the GTH (HTML) web routes
func RegisterRoutes(router *mux.Router, 
	{{range .Features}}{{if ne . "auth"}}{{.}}Service {{. | lower}}core.{{. | Singularize | Capitalize}}Service,
{{end}}{{end}}) {
	// Public Landing Page
	router.HandleFunc("/", handleLandingPage).Methods("GET")

	router.HandleFunc("/admin", handleDashboard).Methods("GET")
	router.HandleFunc("/admin/", handleDashboard).Methods("GET")

	// Module Routes
	{{range .Features}}
	{{if ne . "auth"}}
	router.HandleFunc("/admin/{{. | ToKebabCase}}", func(w http.ResponseWriter, r *http.Request) {
		handle{{. | Capitalize}}Page(w, r, {{.}}Service)
	}).Methods("GET")
	router.HandleFunc("/admin/{{. | ToKebabCase}}/new", handle{{. | Capitalize}}New).Methods("GET")
	router.HandleFunc("/admin/{{. | ToKebabCase}}/search", func(w http.ResponseWriter, r *http.Request) {
		handle{{. | Capitalize}}Search(w, r, {{.}}Service)
	}).Methods("GET")
	router.HandleFunc("/admin/{{. | ToKebabCase}}/{id}/edit", func(w http.ResponseWriter, r *http.Request) {
		handle{{. | Capitalize}}Edit(w, r, {{.}}Service)
	}).Methods("GET")
	router.HandleFunc("/admin/{{. | ToKebabCase}}/{id}/delete", func(w http.ResponseWriter, r *http.Request) {
		handle{{. | Capitalize}}Delete(w, r, {{.}}Service)
	}).Methods("GET")
	{{end}}
	{{end}}
}

func handleLandingPage(w http.ResponseWriter, r *http.Request) {
	renderTempl(w, r, pages.LandingPage())
}

func handleDashboard(w http.ResponseWriter, r *http.Request) {
	stats := []pages.DashboardStats{
		{Label: "System Status", Value: "Online", Icon: "🟢", Color: "#dcfce7"},
	}
	renderTempl(w, r, pages.DashboardPage(stats))
}

{{range .Features}}
{{if ne . "auth"}}
func handle{{. | Capitalize}}Page(w http.ResponseWriter, r *http.Request, service {{. | lower}}core.{{. | Singularize | Capitalize}}Service) {
	// Fetch real items
	filter := {{. | lower}}core.SearchFilter{
		Limit: 100,
	}
	itemsPtr, err := service.List{{. | Singularize | Capitalize | Pluralize}}(filter)
	if err != nil {
		http.Error(w, "Failed to fetch items", http.StatusInternalServerError)
		return
	}
	
	// Convert pointers to values for template
	items := make([]{{. | lower}}core.{{. | Singularize | Capitalize}}, len(itemsPtr))
	for i, item := range itemsPtr {
		items[i] = *item
	}
	
	if r.Header.Get("HX-Target") == "table-body" {
		renderTempl(w, r, partials.{{. | Singularize | Capitalize}}TableRows(items))
		return
	}

	renderTempl(w, r, pages.{{. | Singularize | Capitalize | Pluralize}}Page(items))
}

func handle{{. | Capitalize}}New(w http.ResponseWriter, r *http.Request) {
	item := {{. | lower}}core.{{. | Singularize | Capitalize}}{}
	renderTempl(w, r, components.{{. | Singularize | Capitalize}}FormModal(&item, false))
}

func handle{{. | Capitalize}}Edit(w http.ResponseWriter, r *http.Request, service {{. | lower}}core.{{. | Singularize | Capitalize}}Service) {
	vars := mux.Vars(r)
	id, err := strconv.ParseUint(vars["id"], 10, 32)
	if err != nil {
		http.Error(w, "Invalid ID", http.StatusBadRequest)
		return
	}

	item, err := service.Get{{. | Singularize | Capitalize}}ByID(uint(id))
	if err != nil {
		http.Error(w, "Item not found", http.StatusNotFound)
		return
	}

	renderTempl(w, r, components.{{. | Singularize | Capitalize}}FormModal(item, true))
}

func handle{{. | Capitalize}}Delete(w http.ResponseWriter, r *http.Request, service {{. | lower}}core.{{. | Singularize | Capitalize}}Service) {
	vars := mux.Vars(r)
	// We just need the ID for the confirmation modal, validating existence is optional but good practice
	id, err := strconv.ParseUint(vars["id"], 10, 32)
	if err != nil {
		http.Error(w, "Invalid ID", http.StatusBadRequest)
		return
	}

	_, err = service.Get{{. | Singularize | Capitalize}}ByID(uint(id))
	if err != nil {
		http.Error(w, "Item not found", http.StatusNotFound)
		return
	}

	renderTempl(w, r, components.ConfirmDelete("{{. | Singularize | Capitalize}}", uint(id), "/api/v1/{{. | ToKebabCase}}/" + vars["id"]))
}

func handle{{. | Capitalize}}Search(w http.ResponseWriter, r *http.Request, service {{. | lower}}core.{{. | Singularize | Capitalize}}Service) {
	query := r.URL.Query().Get("sort") // Using sort param for now as per previous search implementation
	if q := r.URL.Query().Get("q"); q != "" {
		query = q
	}

	filter := {{. | lower}}core.SearchFilter{
		Query: query,
		Limit: 100,
	}
	itemsPtr, err := service.List{{. | Singularize | Capitalize | Pluralize}}(filter)
	if err != nil {
		http.Error(w, "Failed to search items", http.StatusInternalServerError)
		return
	}

	items := make([]{{. | lower}}core.{{. | Singularize | Capitalize}}, len(itemsPtr))
	for i, item := range itemsPtr {
		items[i] = *item
	}
	renderTempl(w, r, partials.{{. | Singularize | Capitalize}}TableRows(items))
}
{{end}}
{{end}}

func renderTempl(w http.ResponseWriter, r *http.Request, component templ.Component) {
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	component.Render(r.Context(), w)
}

// IsHTMXRequest checks if the request is from HTMX
func IsHTMXRequest(r *http.Request) bool {
	return r.Header.Get("HX-Request") == "true"
}
