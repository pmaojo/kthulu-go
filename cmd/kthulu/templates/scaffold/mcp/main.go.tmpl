// {{ .ProjectName }} — an MCP server with MCP Apps (interactive UI) support.
//
// Connect it to Claude Desktop / any MCP host:
//
//	{ "mcpServers": { "{{ .ProjectName }}": { "command": "/path/to/{{ .ProjectName }}" } } }
package main

import (
	"context"
	"fmt"
	"os"

	"{{ .ModulePath }}/internal/mcp"
	"{{ .ModulePath }}/internal/tools"
)

func main() {
	server := mcp.NewServer("{{ .ProjectName }}", "0.1.0")
	tools.Register(server)

	fmt.Fprintln(os.Stderr, "{{ .ProjectName }} MCP server listening on stdio")
	if err := server.Serve(context.Background(), os.Stdin, os.Stdout); err != nil {
		fmt.Fprintf(os.Stderr, "server error: %v\n", err)
		os.Exit(1)
	}
}
