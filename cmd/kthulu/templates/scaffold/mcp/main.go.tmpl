package main

import (
	"fmt"
	"os"

	"github.com/metoro-io/mcp-golang"
	"github.com/metoro-io/mcp-golang/transport/stdio"
	"{{ .ModulePath }}/internal/tools"
)

func main() {
	// Create a new MCP server
	server := mcp_golang.NewServer(
		stdio.NewStdioServerTransport(),
		mcp_golang.WithName("{{ .ProjectName }}"),
		mcp_golang.WithVersion("0.1.0"),
	)

	// Register tools
	if err := server.RegisterTool("hello", "Say hello", tools.HelloHandler); err != nil {
		fmt.Fprintf(os.Stderr, "Failed to register tool: %v\n", err)
		os.Exit(1)
	}

	// Start the server
	fmt.Fprintf(os.Stderr, "Starting MCP server {{ .ProjectName }}...\n")
	if err := server.Serve(); err != nil {
		fmt.Fprintf(os.Stderr, "Server error: %v\n", err)
		os.Exit(1)
	}
}
