package partials

import (
	"strconv"
	"my-app/internal/modules/product/core"
)

templ ProductTableRows(items []core.Product) {
	for _, item := range items {
		<tr>
			
			<td>
				
				{ item.Name }
				
			</td>
			
			<td>
				
				{ item.Sku }
				
			</td>
			
			<td>
				
				{ strconv.Itoa(item.Price) }
				
			</td>
			
			<td>
				
				{ item.Description }
				
			</td>
			
			<td>
				
				{ strconv.Itoa(item.Stock) }
				
			</td>
			
			<td style="text-align: right;">
				<div style="display: flex; gap: 0.25rem; justify-content: flex-end;">
					<button 
						class="btn btn-ghost" 
						style="padding: 0.375rem;"
						hx-get={ "/admin/product/" + strconv.FormatUint(uint64(item.ID), 10) + "/edit" }
						hx-target="#modal-container"
					>
						<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
					</button>
					<button 
						class="btn btn-ghost" 
						style="padding: 0.375rem; color: #ef4444;"
						hx-get={ "/admin/product/" + strconv.FormatUint(uint64(item.ID), 10) + "/delete" }
						hx-target="#modal-container"
					>
						<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
					</button>
				</div>
			</td>
		</tr>
	}
	
	if len(items) == 0 {
		<tr>
			<td colspan="100" style="text-align: center; padding: 3rem; color: #64748b;">
				<svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="margin: 0 auto 1rem; opacity: 0.5;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
				<p>No products found</p>
			</td>
		</tr>
	}
}
