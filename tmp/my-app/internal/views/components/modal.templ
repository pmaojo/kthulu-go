package components

import "fmt"

templ Modal(title string) {
	<div class="modal-backdrop" onclick="if(event.target === this) this.remove()">
		<div class="modal">
			<div class="modal-header">
				{ title }
				<button 
					type="button" 
					class="btn btn-ghost" 
					style="position: absolute; right: 1rem; top: 0.75rem;"
					onclick="this.closest('.modal-backdrop').remove()"
				>
					<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
				</button>
			</div>
			<div class="modal-body">
				{ children... }
			</div>
		</div>
	</div>
}

templ ConfirmDelete(entityName string, id uint, endpoint string) {
	<div class="modal-backdrop" onclick="if(event.target === this) this.remove()">
		<div class="modal" style="max-width: 24rem;">
			<div class="modal-header" style="color: #991b1b;">
				Delete { entityName }
			</div>
			<div class="modal-body">
				<p>Are you sure you want to delete this { entityName }? This action cannot be undone.</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-ghost" onclick="this.closest('.modal-backdrop').remove()">
					Cancel
				</button>
				<button 
					type="button" 
					class="btn btn-danger"
					hx-delete={ endpoint }
					hx-target="#modal-container"
					hx-swap="innerHTML"
					hx-on::after-request="htmx.trigger('#table-body', 'refresh'); document.getElementById('modal-container').innerHTML = '';"
				>
					Delete
				</button>
			</div>
		</div>
	</div>
}

templ Search(placeholder string, endpoint string, target string) {
	<div style="position: relative;">
		<svg style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: #94a3b8;" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
		<input 
			type="search" 
			class="input" 
			style="padding-left: 2.5rem;"
			placeholder={ placeholder }
			name="q"
			hx-get={ endpoint }
			hx-target={ target }
			hx-trigger="input changed delay:300ms, search"
			hx-indicator="#search-indicator"
		/>
		<span id="search-indicator" class="htmx-indicator" style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%);">
			<svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="animation: spin 1s linear infinite;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
		</span>
	</div>
	<style>
		@keyframes spin { from { transform: translateY(-50%) rotate(0deg); } to { transform: translateY(-50%) rotate(360deg); } }
	</style>
}

templ Pagination(currentPage, totalPages int, baseURL string) {
	<div style="display: flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem;">
		if currentPage > 1 {
			<button 
				class="btn btn-ghost"
				hx-get={ baseURL + "?page=" + fmt.Sprintf("%d", currentPage-1) }
				hx-target="#table-body"
			>
				Previous
			</button>
		}
		
		<span style="padding: 0 1rem; color: #64748b;">
			Page { fmt.Sprintf("%d", currentPage) } of { fmt.Sprintf("%d", totalPages) }
		</span>
		
		if currentPage < totalPages {
			<button 
				class="btn btn-ghost"
				hx-get={ baseURL + "?page=" + fmt.Sprintf("%d", currentPage+1) }
				hx-target="#table-body"
			>
				Next
			</button>
		}
	</div>
}
