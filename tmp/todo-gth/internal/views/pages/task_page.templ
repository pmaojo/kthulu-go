package pages

import (
	"todo-gth/internal/views/layouts"
	"todo-gth/internal/views/components"
	"todo-gth/internal/modules/task/core"
)

templ TasksPage(items []core.Task) {
	@layouts.Admin("Tasks", "/admin/task") {
		<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
			<div>
				<h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Tasks</h1>
				<p style="color: #64748b;">Manage your tasks</p>
			</div>
			<button 
				class="btn btn-primary"
				hx-get="/admin/task/new"
				hx-target="#modal-container"
			>
				<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
				Add Task
			</button>
		</div>
		
		<div style="margin-bottom: 1rem; display: flex; gap: 1rem;">
			@components.Search("Search tasks...", "/admin/task/search", "#table-body")
		</div>
		
		@components.TaskTable(items, []components.TableColumn{
			
			{Key: "name", Label: "Name", Sortable: true},
			
		})
	}
}
