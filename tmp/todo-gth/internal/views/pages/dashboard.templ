package pages

import "todo-gth/internal/views/layouts"

type DashboardStats struct {
	Label string
	Value string
	Icon  string
	Color string
}

templ DashboardPage(stats []DashboardStats) {
	@layouts.Admin("Dashboard", "/admin") {
		<div style="margin-bottom: 2rem;">
			<h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Dashboard</h1>
			<p style="color: #64748b;">Welcome to the todo-gth admin panel</p>
		</div>
		
		<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
			for _, stat := range stats {
				<div class="card" style="padding: 1.5rem;">
					<div style="display: flex; align-items: center; justify-content: space-between;">
						<div>
							<p style="font-size: 0.875rem; color: #64748b; margin-bottom: 0.25rem;">{ stat.Label }</p>
							<p style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">{ stat.Value }</p>
						</div>
						<div style={ "width: 3rem; height: 3rem; border-radius: 0.5rem; display: flex; align-items: center; justify-content: center; background: " + stat.Color }>
							@templ.Raw(stat.Icon)
						</div>
					</div>
				</div>
			}
		</div>
		
		<div class="card" style="padding: 1.5rem;">
			<h2 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">Quick Actions</h2>
			<div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
				
				<a href="/admin/task" class="btn btn-ghost" style="border: 1px solid #e2e8f0;">
					Manage Task
				</a>
				
			</div>
		</div>
	}
}
