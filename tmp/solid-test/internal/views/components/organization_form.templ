package components

import (
	"strconv"
	"solid-test/internal/modules/organization/core"
)

templ OrganizationForm(item *core.Organization, isEdit bool) {
	<form 
		if isEdit {
			hx-put={ "/api/organization/" + strconv.FormatUint(uint64(item.ID), 10) }
		} else {
			hx-post="/api/organization"
		}
		hx-target="#modal-container"
		hx-swap="innerHTML"
		hx-on::after-request="if(event.detail.successful) { htmx.trigger('#table-body', 'refresh'); document.getElementById('modal-container').innerHTML = ''; }"
	>
		<div class="modal-header">
			if isEdit {
				Edit Organization
			} else {
				Create Organization
			}
		</div>
		
		<div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
			
		</div>
		
		<div class="modal-footer">
			<button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-container').innerHTML = ''">
				Cancel
			</button>
			<button type="submit" class="btn btn-primary">
				if isEdit {
					Update
				} else {
					Create
				}
			</button>
		</div>
	</form>
}

templ OrganizationFormModal(item *core.Organization, isEdit bool) {
	<div class="modal-backdrop" onclick="if(event.target === this) this.remove()">
		<div class="modal">
			@OrganizationForm(item, isEdit)
		</div>
	</div>
}
