package layouts

templ Admin(title string, currentPath string) {
	@Base(title) {
		<aside class="sidebar">
			<div style="margin-bottom: 2rem;">
				<h1 style="color: white; font-size: 1.25rem; font-weight: 700;">solid-test</h1>
				<p style="color: #64748b; font-size: 0.75rem;">Admin Panel</p>
			</div>
			
			<nav>
				<a href="/admin" class={ "sidebar-link", templ.KV("active", currentPath == "/admin") }>
					<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
					Dashboard
				</a>
				
				<a href="/admin/product" class={ "sidebar-link", templ.KV("active", currentPath == "/admin/product") }>
					<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
					Product
				</a>
				
				<a href="/admin/user" class={ "sidebar-link", templ.KV("active", currentPath == "/admin/user") }>
					<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
					User
				</a>
				
				<a href="/admin/organization" class={ "sidebar-link", templ.KV("active", currentPath == "/admin/organization") }>
					<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
					Organization
				</a>
				
				<a href="/admin/auth" class={ "sidebar-link", templ.KV("active", currentPath == "/admin/auth") }>
					<svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
					Auth
				</a>
				
			</nav>
		</aside>
		
		<main class="main-content">
			{ children... }
		</main>
		
		<!-- Modal Container for HTMX -->
		<div id="modal-container"></div>
	}
}
