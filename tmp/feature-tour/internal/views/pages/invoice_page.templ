package pages

import (
	"feature-tour/internal/views/layouts"
	"feature-tour/internal/views/components"
	"feature-tour/internal/modules/invoice/core"
)

templ InvoicesPage(items []core.Invoice) {
	@layouts.Admin("Invoices", "/admin/invoice") {
		<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
			<div>
				<h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Invoices</h1>
				<p style="color: #64748b;">Manage your invoices</p>
			</div>
			<button 
				class="btn btn-primary"
				hx-get="/admin/invoice/new"
				hx-target="#modal-container"
			>
				<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
				Add Invoice
			</button>
		</div>
		
		<div style="margin-bottom: 1rem; display: flex; gap: 1rem;">
			@components.Search("Search invoices...", "/admin/invoice/search", "#table-body")
		</div>
		
		@components.InvoiceTable(items, []components.TableColumn{
			
			{Key: "customer_id", Label: "Customer_id", Sortable: true},
			
			{Key: "amount", Label: "Amount", Sortable: true},
			
			{Key: "status", Label: "Status", Sortable: true},
			
			{Key: "due_date", Label: "Due_date", Sortable: true},
			
		})
	}
}
