package pages

import (
	"feature-tour/internal/views/layouts"
	"feature-tour/internal/views/components"
	"feature-tour/internal/modules/mail/core"
)

templ MailsPage(items []core.Mail) {
	@layouts.Admin("Mails", "/admin/mail") {
		<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
			<div>
				<h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Mails</h1>
				<p style="color: #64748b;">Manage your mails</p>
			</div>
			<button 
				class="btn btn-primary"
				hx-get="/admin/mail/new"
				hx-target="#modal-container"
			>
				<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
				Add Mail
			</button>
		</div>
		
		<div style="margin-bottom: 1rem; display: flex; gap: 1rem;">
			@components.Search("Search mails...", "/admin/mail/search", "#table-body")
		</div>
		
		@components.MailTable(items, []components.TableColumn{
			
			{Key: "name", Label: "Name", Sortable: true},
			
		})
	}
}
