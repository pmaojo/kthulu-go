package pages

import "feature-tour/internal/views/layouts"

templ LandingPage() {
	@layouts.Base("Welcome") {
		<div class="bg-white">
			<header class="absolute inset-x-0 top-0 z-50">
				<nav class="flex items-center justify-between p-6 lg:px-8" aria-label="Global">
					<div class="flex lg:flex-1">
						<a href="#" class="-m-1.5 p-1.5">
							<span class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600">feature-tour</span>
						</a>
					</div>
					<div class="flex lg:flex-1 justify-end">
						<a href="/admin" class="text-sm font-semibold leading-6 text-gray-900">Log in <span aria-hidden="true">&rarr;</span></a>
					</div>
				</nav>
			</header>

			<div class="relative isolate px-6 pt-14 lg:px-8">
				<div class="mx-auto max-w-2xl py-32 sm:py-48 lg:py-56">
					<div class="text-center">
						<h1 class="text-4xl font-bold tracking-tight text-gray-900 sm:text-6xl">
							Build faster with feature-tour
						</h1>
						<p class="mt-6 text-lg leading-8 text-gray-600">
							A powerful, modular Go framework designed for modern web applications. 
							Experience the speed of Go combined with the simplicity of HTMX.
						</p>
						<div class="mt-10 flex items-center justify-center gap-x-6">
							<a href="/admin" class="rounded-md bg-blue-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600">
								Get started
							</a>
							<a href="https://docs.kthulu.dev" class="text-sm font-semibold leading-6 text-gray-900">
								Learn more <span aria-hidden="true">→</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	}
}
