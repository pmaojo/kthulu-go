package components

import (
	"strconv"
	"feature-tour/internal/modules/mail/core"
)

templ MailForm(item *core.Mail, isEdit bool) {
	<form 
		if isEdit {
			hx-put={ "/api/v1/mail/" + strconv.FormatUint(uint64(item.ID), 10) }
		} else {
			hx-post="/api/v1/mail/"
		}
		hx-target="#modal-container"
		hx-swap="none"
		hx-ext="json-enc"
		hx-on::after-request="if(event.detail.successful) { htmx.trigger('#table-body', 'refresh'); document.getElementById('modal-container').innerHTML = ''; }"
	>
		<div class="modal-header">
			if isEdit {
				Edit Mail
			} else {
				Create Mail
			}
		</div>
		
		<div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
			
			<div>
				<label class="label" for="name">Name</label>
				
				<input 
					type="text" 
					id="name" 
					name="name" 
					class="input"
					value={ item.Name }
				/>
				
			</div>
			
		</div>
		
		<div class="modal-footer">
			<button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-container').innerHTML = ''">
				Cancel
			</button>
			<button type="submit" class="btn btn-primary">
				if isEdit {
					Update
				} else {
					Create
				}
			</button>
		</div>
	</form>
}

templ MailFormModal(item *core.Mail, isEdit bool) {
	<div class="modal-backdrop" onclick="if(event.target === this) this.remove()">
		<div class="modal">
			@MailForm(item, isEdit)
		</div>
	</div>
}
