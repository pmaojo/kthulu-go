package pages

import (
	"vercel-test/internal/views/layouts"
	"vercel-test/internal/views/components"
	"vercel-test/internal/modules/product/core"
)

templ ProductsPage(items []core.Product) {
	@layouts.Admin("Products", "/admin/product") {
		<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
			<div>
				<h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Products</h1>
				<p style="color: #64748b;">Manage your products</p>
			</div>
			<button 
				class="btn btn-primary"
				hx-get="/admin/product/new"
				hx-target="#modal-container"
			>
				<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
				Add Product
			</button>
		</div>
		
		<div style="margin-bottom: 1rem; display: flex; gap: 1rem;">
			@components.Search("Search products...", "/admin/product/search", "#table-body")
		</div>
		
		@components.ProductTable(items, []components.TableColumn{
			
			{Key: "name", Label: "Name", Sortable: true},
			
			{Key: "sku", Label: "Sku", Sortable: true},
			
			{Key: "price", Label: "Price", Sortable: true},
			
			{Key: "description", Label: "Description", Sortable: true},
			
			{Key: "stock", Label: "Stock", Sortable: true},
			
		})
	}
}
