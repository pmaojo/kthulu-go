package pages

import (
	"kitchen-sink-test/internal/views/layouts"
	"kitchen-sink-test/internal/views/components"
	"kitchen-sink-test/internal/modules/verifactu/core"
)

templ VerifactusPage(items []core.Verifactu) {
	@layouts.Admin("Verifactus", "/admin/verifactu") {
		<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
			<div>
				<h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Verifactus</h1>
				<p style="color: #64748b;">Manage your verifactus</p>
			</div>
			<button 
				class="btn btn-primary"
				hx-get="/admin/verifactu/new"
				hx-target="#modal-container"
			>
				<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
				Add Verifactu
			</button>
		</div>
		
		<div style="margin-bottom: 1rem; display: flex; gap: 1rem;">
			@components.Search("Search verifactus...", "/admin/verifactu/search", "#table-body")
		</div>
		
		@components.VerifactuTable(items, []components.TableColumn{
			
			{Key: "invoice_id", Label: "Invoice_id", Sortable: true},
			
			{Key: "status", Label: "Status", Sortable: true},
			
			{Key: "fiscal_data", Label: "Fiscal_data", Sortable: true},
			
		})
	}
}
