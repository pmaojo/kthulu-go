package pages

import (
	"kitchen-sink-test/internal/views/layouts"
	"kitchen-sink-test/internal/views/components"
	"kitchen-sink-test/internal/modules/organization/core"
)

templ OrganizationsPage(items []core.Organization) {
	@layouts.Admin("Organizations", "/admin/organization") {
		<div style="margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
			<div>
				<h1 style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Organizations</h1>
				<p style="color: #64748b;">Manage your organizations</p>
			</div>
			<button 
				class="btn btn-primary"
				hx-get="/admin/organization/new"
				hx-target="#modal-container"
			>
				<svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
				Add Organization
			</button>
		</div>
		
		<div style="margin-bottom: 1rem; display: flex; gap: 1rem;">
			@components.Search("Search organizations...", "/admin/organization/search", "#table-body")
		</div>
		
		@components.OrganizationTable(items, []components.TableColumn{
			
		})
	}
}
