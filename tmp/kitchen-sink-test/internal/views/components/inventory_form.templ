package components

import (
	"strconv"
	"kitchen-sink-test/internal/modules/inventory/core"
)

templ InventoryForm(item *core.Inventory, isEdit bool) {
	<form 
		if isEdit {
			hx-put={ "/api/v1/inventory/" + strconv.FormatUint(uint64(item.ID), 10) }
		} else {
			hx-post="/api/v1/inventory/"
		}
		hx-target="#modal-container"
		hx-swap="none"
		hx-ext="json-enc"
		hx-on::after-request="if(event.detail.successful) { htmx.trigger('#table-body', 'refresh'); document.getElementById('modal-container').innerHTML = ''; }"
	>
		<div class="modal-header">
			if isEdit {
				Edit Inventory
			} else {
				Create Inventory
			}
		</div>
		
		<div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
			
			<div>
				<label class="label" for="product_id">Product_id</label>
				
				<input 
					type="number" 
					id="product_id" 
					name="product_id" 
					class="input"
					value={ strconv.Itoa(item.Product_id) }
				/>
				
			</div>
			
			<div>
				<label class="label" for="quantity">Quantity</label>
				
				<input 
					type="number" 
					id="quantity" 
					name="quantity" 
					class="input"
					value={ strconv.Itoa(item.Quantity) }
				/>
				
			</div>
			
			<div>
				<label class="label" for="warehouse">Warehouse</label>
				
				<input 
					type="text" 
					id="warehouse" 
					name="warehouse" 
					class="input"
					value={ item.Warehouse }
				/>
				
			</div>
			
		</div>
		
		<div class="modal-footer">
			<button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-container').innerHTML = ''">
				Cancel
			</button>
			<button type="submit" class="btn btn-primary">
				if isEdit {
					Update
				} else {
					Create
				}
			</button>
		</div>
	</form>
}

templ InventoryFormModal(item *core.Inventory, isEdit bool) {
	<div class="modal-backdrop" onclick="if(event.target === this) this.remove()">
		<div class="modal">
			@InventoryForm(item, isEdit)
		</div>
	</div>
}
