package components

import (
	"strconv"
	"kitchen-sink-test/internal/modules/calendar/core"
)

templ CalendarForm(item *core.Calendar, isEdit bool) {
	<form 
		if isEdit {
			hx-put={ "/api/v1/calendar/" + strconv.FormatUint(uint64(item.ID), 10) }
		} else {
			hx-post="/api/v1/calendar/"
		}
		hx-target="#modal-container"
		hx-swap="none"
		hx-ext="json-enc"
		hx-on::after-request="if(event.detail.successful) { htmx.trigger('#table-body', 'refresh'); document.getElementById('modal-container').innerHTML = ''; }"
	>
		<div class="modal-header">
			if isEdit {
				Edit Calendar
			} else {
				Create Calendar
			}
		</div>
		
		<div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
			
			<div>
				<label class="label" for="name">Name</label>
				
				<input 
					type="text" 
					id="name" 
					name="name" 
					class="input"
					value={ item.Name }
				/>
				
			</div>
			
			<div>
				<label class="label" for="start_time">Start_time</label>
				
				<input 
					type="text" 
					id="start_time" 
					name="start_time" 
					class="input"
					value={ item.Start_time }
				/>
				
			</div>
			
			<div>
				<label class="label" for="end_time">End_time</label>
				
				<input 
					type="text" 
					id="end_time" 
					name="end_time" 
					class="input"
					value={ item.End_time }
				/>
				
			</div>
			
			<div>
				<label class="label" for="location">Location</label>
				
				<input 
					type="text" 
					id="location" 
					name="location" 
					class="input"
					value={ item.Location }
				/>
				
			</div>
			
		</div>
		
		<div class="modal-footer">
			<button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-container').innerHTML = ''">
				Cancel
			</button>
			<button type="submit" class="btn btn-primary">
				if isEdit {
					Update
				} else {
					Create
				}
			</button>
		</div>
	</form>
}

templ CalendarFormModal(item *core.Calendar, isEdit bool) {
	<div class="modal-backdrop" onclick="if(event.target === this) this.remove()">
		<div class="modal">
			@CalendarForm(item, isEdit)
		</div>
	</div>
}
