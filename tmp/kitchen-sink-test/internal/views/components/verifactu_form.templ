package components

import (
	"strconv"
	"kitchen-sink-test/internal/modules/verifactu/core"
)

templ VerifactuForm(item *core.Verifactu, isEdit bool) {
	<form 
		if isEdit {
			hx-put={ "/api/v1/verifactu/" + strconv.FormatUint(uint64(item.ID), 10) }
		} else {
			hx-post="/api/v1/verifactu/"
		}
		hx-target="#modal-container"
		hx-swap="none"
		hx-ext="json-enc"
		hx-on::after-request="if(event.detail.successful) { htmx.trigger('#table-body', 'refresh'); document.getElementById('modal-container').innerHTML = ''; }"
	>
		<div class="modal-header">
			if isEdit {
				Edit Verifactu
			} else {
				Create Verifactu
			}
		</div>
		
		<div class="modal-body" style="display: flex; flex-direction: column; gap: 1rem;">
			
			<div>
				<label class="label" for="invoice_id">Invoice_id</label>
				
				<input 
					type="number" 
					id="invoice_id" 
					name="invoice_id" 
					class="input"
					value={ strconv.Itoa(item.Invoice_id) }
				/>
				
			</div>
			
			<div>
				<label class="label" for="status">Status</label>
				
				<input 
					type="text" 
					id="status" 
					name="status" 
					class="input"
					value={ item.Status }
				/>
				
			</div>
			
			<div>
				<label class="label" for="fiscal_data">Fiscal_data</label>
				
				<input 
					type="text" 
					id="fiscal_data" 
					name="fiscal_data" 
					class="input"
					value={ item.Fiscal_data }
				/>
				
			</div>
			
		</div>
		
		<div class="modal-footer">
			<button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-container').innerHTML = ''">
				Cancel
			</button>
			<button type="submit" class="btn btn-primary">
				if isEdit {
					Update
				} else {
					Create
				}
			</button>
		</div>
	</form>
}

templ VerifactuFormModal(item *core.Verifactu, isEdit bool) {
	<div class="modal-backdrop" onclick="if(event.target === this) this.remove()">
		<div class="modal">
			@VerifactuForm(item, isEdit)
		</div>
	</div>
}
